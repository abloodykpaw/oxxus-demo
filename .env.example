# Local development (copy to .env.local — never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: Management API (Auth URL / email templates scripts)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=pyicqwrtazdjzdezgdcn

# ChatGPT Sites / Cloudflare Workers hosted env (same public keys only)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Edge function secret (set in Supabase Dashboard → Edge Functions → Secrets)
# Required for "Extraer con Asistente OXXUS" score screenshots:
# OPENAI_API_KEY=sk-...
# Deploy: supabase functions deploy extract-score-image

